# =============================================================================
# Office Attend — environment template
# Copy to `.env` and fill in values. Restart Expo after edits: npx expo start -c
#
# Leave Firebase vars empty → local SQLite (dev).
# Fill required Firebase vars → online Firestore (production / shared kiosk).
# Never commit `.env` (gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (required for cloud mode)
# Source: Firebase Console → Project settings → Your apps → Web app config
#   Or map from google-services.json (Android package com.attendface.app):
#     api_key.current_key          → EXPO_PUBLIC_FIREBASE_API_KEY
#     project_info.project_id      → EXPO_PUBLIC_FIREBASE_PROJECT_ID
#     project_info.storage_bucket  → EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET
#     project_info.project_number  → EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#     client_info.mobilesdk_app_id → EXPO_PUBLIC_FIREBASE_APP_ID
#   AUTH_DOMAIN optional — defaults to {PROJECT_ID}.firebaseapp.com if blank
#   MEASUREMENT_ID optional (Analytics)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase Storage for punch / profile photos
#   false = keep photos on device only (default, no Storage billing)
#   true  = upload to Firebase Storage (enable Storage in Console first)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_USE_STORAGE=false

# -----------------------------------------------------------------------------
# Google Sign-In (optional but recommended)
# Source: Firebase Console → Authentication → Sign-in method → Google
#
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID  (REQUIRED)
#     = Web client ID from THIS Firebase project (…apps.googleusercontent.com)
#     NEVER paste an Android client ID here — causes DEVELOPER_ERROR on APK.
#
#   Also required for APKs:
#     1) Push this var to EAS preview env
#     2) Add EAS keystore SHA-1/SHA-256 to Firebase Android app (com.attendface.app)
#     3) Rebuild APK (Google does not work in Expo Go)
#   See FIREBASE.md → Google Sign-In.
#
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID / IOS — optional; native flow uses WEB client ID.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# -----------------------------------------------------------------------------
# Expo Application Services (EAS)
# Source: expo.dev → your project → Project settings → Project ID
# Also used in app.config.ts extra.eas.projectId
# -----------------------------------------------------------------------------
EAS_PROJECT_ID=
