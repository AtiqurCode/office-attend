# --- Backend ---
# Leave Firebase vars empty → local SQLite.
# Fill required Firebase vars → online-only Firestore.

# From google-services.json / Firebase Console Web app config:
#   api_key.current_key          → EXPO_PUBLIC_FIREBASE_API_KEY
#   project_info.project_id      → EXPO_PUBLIC_FIREBASE_PROJECT_ID
#   project_info.storage_bucket  → EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET
#   project_info.project_number  → EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   client_info.mobilesdk_app_id → EXPO_PUBLIC_FIREBASE_APP_ID
#   auth domain (optional)       → {project_id}.firebaseapp.com if omitted

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Punch photos: false = local device only (default). true = Firebase Storage upload.
EXPO_PUBLIC_FIREBASE_USE_STORAGE=false

# Google Sign-In (Firebase Auth → Google → Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional EAS
EAS_PROJECT_ID=
